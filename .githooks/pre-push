#!/bin/zsh
set -euo pipefail

EXPECTED_TAG="${CURRENT_RELEASE_TAG:-}"
EXPECTED_COMMIT="${CURRENT_RELEASE_COMMIT:-}"

reject() {
  print -u2 -- "$1"
  exit 1
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$remote_ref" == refs/tags/v* ]] || continue

  tag_name="${remote_ref#refs/tags/}"
  [[ "$tag_name" =~ '^v[0-9]+\.[0-9]+\.[0-9]+$' ]] || {
    reject "Release tags must use the numeric vX.Y.Z format (received: $tag_name)."
  }
  [[ ! "$local_oid" =~ '^0+$' ]] || {
    reject "Release tags cannot be deleted through an ordinary push: $tag_name"
  }

  tag_commit="$(git rev-parse "${local_oid}^{commit}" 2>/dev/null)" || {
    reject "Release tag $tag_name does not resolve to a commit."
  }

  if [[ "$EXPECTED_TAG" == "$tag_name" && "$EXPECTED_COMMIT" == "$tag_commit" ]]; then
    continue
  fi

  reject "Direct release-tag pushes are disabled. Run ./app/release.sh $tag_name so Current is signed, notarized, verified, and published before the release completes."
done

exit 0
